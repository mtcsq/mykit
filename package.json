{
  "name": "mykit",
  "version": "0.1.0",
  "description": "A dependency-free video template renderer: headless Chrome + CDP + FFmpeg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mykit": "src/cli.mjs"
  },
  "files": [
    "src",
    "spec",
    "docs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:int": "node --test \"test/integration/*.test.mjs\"",
    "test:all": "node --test \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\""
  }
}
